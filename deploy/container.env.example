# EXAMPLES ONLY. Supply actual values in private Unraid container settings.
STGUARD_MODE=dry-run
STGUARD_CONFIG_SOURCE=env
TZ=Australia/Melbourne
STGUARD_QBIT_URL=https://downloader.example.invalid
STGUARD_QBIT_USERNAME=REPLACE_ME
STGUARD_QBIT_PASSWORD=REPLACE_ME
STGUARD_SONARR_HD_URL=http://sonarr-hd.example.invalid:8989
STGUARD_SONARR_HD_API_KEY=REPLACE_ME
STGUARD_SONARR_HD_CATEGORY=tv-hd
STGUARD_SONARR_HD_CLIENT_ID=1
STGUARD_SONARR_HD_PUBLIC_INDEXERS=["Public Source"]
STGUARD_SONARR_HD_PRIVATE_INDEXERS=["Private Source"]
STGUARD_SONARR_UHD_URL=http://sonarr-uhd.example.invalid:8989
STGUARD_SONARR_UHD_API_KEY=REPLACE_ME
STGUARD_SONARR_UHD_CATEGORY=tv-uhd
STGUARD_SONARR_UHD_CLIENT_ID=1
STGUARD_SONARR_UHD_PUBLIC_INDEXERS=["Public Source"]
STGUARD_SONARR_UHD_PRIVATE_INDEXERS=["Private Source"]
