<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>sonarr-torrent-guard-staging</Name>
  <Repository>ghcr.io/REPLACE_ME/sonarr-torrent-guard@sha256:b848638bbef7963729ae829403c040c71ec7efe205c2f26c00a9ced540b669bf</Repository>
  <Registry>https://github.com/REPLACE_ME/Sonarr-Torrent-Guard/pkgs/container/sonarr-torrent-guard</Registry>
  <Project>https://github.com/REPLACE_ME/Sonarr-Torrent-Guard</Project>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Icon>https://raw.githubusercontent.com/REPLACE_ME/Sonarr-Torrent-Guard/main/assets/sonarr-torrent-guard-darker.png</Icon>
  <WebUI/>
  <Overview>Dry-run Sonarr Torrent Guard staging. Checks both Sonarr owners and qBittorrent without removing, blocklisting or searching. No web UI yet. Supply private connection settings below; do not share an edited template. Live migration is separate and gated.</Overview>
  <Category>Tools:System</Category>
  <ExtraParams>--user=1000:1000 --read-only --cap-drop=ALL --security-opt=no-new-privileges --stop-timeout=10 --log-driver=json-file --log-opt=max-size=10m --log-opt=max-file=3</ExtraParams>
  <Config Name="Private staging appdata" Target="/config" Default="/mnt/user/appdata/sonarr-torrent-guard-staging" Mode="rw" Description="Create this dedicated directory owned by UID/GID 1000:1000, mode 0700, before first start. Never map a whole appdata share or media/download directory. Staging only; do not overwrite or copy a live journal while its worker is running." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Mode" Target="STGUARD_MODE" Default="dry-run" Description="Keep dry-run for staging; the reviewed container live gate is disabled." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Configuration source" Target="STGUARD_CONFIG_SOURCE" Default="env" Description="env uses these private settings. file preserves an existing private connections.json. Never rename owners or reset journals to bypass holds." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Timezone" Target="TZ" Default="Australia/Melbourne" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="qBittorrent HTTPS address" Target="STGUARD_QBIT_URL" Default="https://downloader.example.invalid" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="qBittorrent username" Target="STGUARD_QBIT_USERNAME" Default="REPLACE_ME" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="qBittorrent password" Target="STGUARD_QBIT_PASSWORD" Default="REPLACE_ME" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Sonarr HD address" Target="STGUARD_SONARR_HD_URL" Default="http://sonarr-hd.example.invalid:8989" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr HD API key" Target="STGUARD_SONARR_HD_API_KEY" Default="REPLACE_ME" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Sonarr HD category" Target="STGUARD_SONARR_HD_CATEGORY" Default="tv-hd" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr HD pinned client ID" Target="STGUARD_SONARR_HD_CLIENT_ID" Default="1" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr HD public indexers" Target="STGUARD_SONARR_HD_PUBLIC_INDEXERS" Default="[]" Description="JSON array of exact approved public indexer names. Empty means no approved public sources." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr HD private indexers" Target="STGUARD_SONARR_HD_PRIVATE_INDEXERS" Default="[]" Description="JSON array of exact protected private indexer names. Unknown sources remain protected." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr UHD address" Target="STGUARD_SONARR_UHD_URL" Default="http://sonarr-uhd.example.invalid:8989" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr UHD API key" Target="STGUARD_SONARR_UHD_API_KEY" Default="REPLACE_ME" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Sonarr UHD category" Target="STGUARD_SONARR_UHD_CATEGORY" Default="tv-uhd" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr UHD pinned client ID" Target="STGUARD_SONARR_UHD_CLIENT_ID" Default="1" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr UHD public indexers" Target="STGUARD_SONARR_UHD_PUBLIC_INDEXERS" Default="[]" Description="JSON array of exact approved public indexer names. Empty means no approved public sources." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Sonarr UHD private indexers" Target="STGUARD_SONARR_UHD_PRIVATE_INDEXERS" Default="[]" Description="JSON array of exact protected private indexer names. Unknown sources remain protected." Type="Variable" Display="always" Required="true" Mask="false"/>
</Container>
